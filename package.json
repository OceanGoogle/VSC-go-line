{
  "name": "ctrl-g-jump",
  "displayName": "Ctrol G jump",
  "description": "go Up/Down number of lines , also be able to go absolute line numbers",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OceanGoogle/VSC-go-line.git"
  },
  "author": "Ocean",
  "publisher": "ocean-54",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OceanGoogle/VSC-go-line/issues"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "publish": "git stash --include-untracked && vsce publish && git stash apply",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
  "engines": {
    "vscode": "^1.45.1"
  },
  "icon": "images/ctrl_G.jpg",
  "galleryBanner": {
    "theme": "light",
    "color": "#ffa600"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "relative",
    "goto",
    "lines",
    "jump",
    "ctrl+g"
  ],
  "activationEvents": [
    "onCommand:ctrl_g_go"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ctrl_g_go",
        "title": "Goto relative line"
      }
    ],
    "keybindings": [
      {
        "command": "ctrl_g_go",
        "key": "alt+ctrl+g"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^14.0.5",
    "@types/vscode": "^1.45.1",
    "@typescript-eslint/eslint-plugin": "^3.0.2",
    "@typescript-eslint/parser": "^3.0.2",
    "eslint": "^7.1.0",
    "typescript": "^3.9.10"
  }
}
